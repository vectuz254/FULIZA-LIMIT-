  <!-- ABOUT -->
  <section id="about">
    <h2>What is Fuliza?</h2>
    <div class="about-grid">
      <div class="about-card">
        <span class="icon">📱</span>
        <h3>How It Works</h3>
        <p>When your M-PESA balance is insufficient, Fuliza automatically tops up your transaction. You repay from your next M-PESA deposit.</p>
      </div>
      <div class="about-card">
        <span class="icon">📅</span>
        <h3>Daily Charges</h3>
        <p>Fuliza charges a daily maintenance fee based on the outstanding overdraft amount until it is fully repaid.</p>
      </div>
      <div class="about-card">
        <span class="icon">✅</span>
        <h3>Auto Repayment</h3>
        <p>Any money received into your M-PESA is automatically used to repay your Fuliza balance first before you can access it.</p>
      </div>
      <div class="about-card">
        <span class="icon">🔓</span>
        <h3>How to Activate</h3>
        <p>Dial *234# or open M-PESA app → Fuliza → Activate. Your limit is set based on your M-PESA usage history.</p>
      </div>
    </div>
  </section>

